# =========================================================================
# CareerPilot frontend environment contract
#
# These VITE_* variables are baked into the static bundle at build time.
# The Firebase values are the project's PUBLIC client configuration (they are
# shipped to the browser by design and are not secrets).
#
# SECURITY: VITE_* values are PUBLIC — anyone can read them from the deployed
# bundle. NEVER put a secret in a VITE_* variable (backend API keys, Firebase
# Admin SDK / service-account credentials, database URLs, JWT secrets, etc.).
#
# Sections: REQUIRED (production build), OPTIONAL/DEVELOPMENT-ONLY.
# =========================================================================

# -------------------------------------------------------------------------
# REQUIRED - API base URL
# -------------------------------------------------------------------------
# The single source of truth for the backend API origin. A trailing slash is
# normalized away by the client, but omit it for clarity. The backend exposes
# its routes at the root (NO /api prefix): /jobs, /resumes, /applications,
# /analytics, ...
#
# Development example (also the client's built-in default):
#   VITE_API_BASE_URL=http://127.0.0.1:8000
#
# Production example (placeholder — replace with YOUR deployed HTTPS origin):
#   VITE_API_BASE_URL=https://api.careerpilot.app
#
# Production enforcement (vite.config.js, `npm run build`):
#   - If missing, the build FAILS with a clear message.
#   - If it points at localhost/127.0.0.1, the build prints a loud warning.
VITE_API_BASE_URL=http://localhost:8000

# -------------------------------------------------------------------------
# REQUIRED - Firebase public client configuration (Google/Firebase console)
# -------------------------------------------------------------------------
# These are the browser-facing Firebase SDK values. They are PUBLIC by design —
# Firebase client configuration is not a secret (the browser needs it to talk
# to Firebase). Do NOT put a Firebase service-account JSON or Admin SDK key here.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=