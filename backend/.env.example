DATABASE_URL=postgresql://user:password@localhost:5432/careerpilot
FIREBASE_PROJECT_ID=your-firebase-project-id
ADZUNA_APP_ID=your-adzuna-app-id
ADZUNA_APP_KEY=your-adzuna-app-key
ADZUNA_COUNTRY=us

# External job source request timeouts (seconds). Discovery never waits forever.
ADZUNA_TIMEOUT_SECONDS=20
JOBICY_TIMEOUT_SECONDS=20

# Jooble API integration (Phase 5A). Free tier: 500 lifetime requests per key.
# Obtain a key at https://jooble.org/api/about
JOOBLE_API_KEY=
JOOBLE_TIMEOUT_SECONDS=20

# Optional AI Resume Tailoring (Phase 3A).
# Leave empty to disable AI tailoring; the API will return a clear error.
AI_PROVIDER=openai
AI_API_KEY=
AI_MODEL=gpt-4o-mini
AI_TIMEOUT_SECONDS=60
