# =========================================================================
# CareerPilot backend environment contract
#
# Values shown here are PLACEHOLDERS / defaults. Never commit real secrets.
# The app reads these from the process environment (preferred in production)
# or from a local .env file in this directory (development/testing only).
#
# Sections: REQUIRED (production cannot start without a real value),
#           OPTIONAL (feature-gated),
#           DEVELOPMENT-ONLY (tests / local runs).
# =========================================================================

# -------------------------------------------------------------------------
# REQUIRED - production
# -------------------------------------------------------------------------

# PostgreSQL connection string. No default; the local default below is
# DEVELOPMENT-ONLY and will not work against a real database.
DATABASE_URL=postgresql://user:password@localhost:5432/careerpilot

# Deployment environment. Values: development (default), test, production.
# In production/staging, CORS_ORIGINS MUST be set explicitly - the backend
# refuses to start otherwise (it never silently allows all or localhost-only
# origins in production).
ENVIRONMENT=development

# Application log level. Values: DEBUG, INFO (default), WARNING, ERROR, CRITICAL.
# In production, INFO is sufficient for request visibility; WARNING/ERROR remain
# visible regardless of this setting.
LOG_LEVEL=INFO

# Comma-separated list of allowed browser origins (scheme://host[:port], no
# trailing slash, no path). No wildcards. Example:
# CORS_ORIGINS=https://app.careerpilot.app,https://admin.careerpilot.app
# When empty, development/test environments fall back to the localhost origins.
CORS_ORIGINS=

# Root directory for uploaded files (resumes, application documents). When
# empty, the project-local default backend/uploads is used. If set, it must be
# an absolute path to a directory the app user can write to; a per-user
# subdirectory is created beneath it (STORAGE_ROOT/<user_id>/). Optional.
# STORAGE_ROOT=/var/lib/careerpilot/uploads
STORAGE_ROOT=

# Comma-separated list of allowed Host header values for this deployment
# (e.g. api.careerpilot.app, or *.careerpilot.app for wildcard subdomains).
# Development/test default when empty: localhost, 127.0.0.1, ::1.
# Production/staging MUST set this explicitly - startup fails if empty there.
TRUSTED_HOSTS=

# Global request-body cap in bytes (default 16 MiB = 16777216). This is a
# defensive, application-level limit and is intentionally LARGER than the
# per-file 10 MiB resume/document upload limit. It rejects oversized bodies
# (declared Content-Length or chunked) early with HTTP 413. Production
# deployments should also configure a matching limit at the reverse proxy.
# MAX_REQUEST_BODY_BYTES=16777216

# Emit Strict-Transport-Security (max-age=31536000) on responses. Enable ONLY
# on an HTTPS production deployment. Disabled by default, including in
# production, so plain-HTTP is never told to upgrade.
# ENABLE_HSTS=false

# Security response headers (X-Content-Type-Options, X-Frame-Options,
# Referrer-Policy, Content-Security-Policy) are always applied and are not
# configurable.

# -------------------------------------------------------------------------
# OPTIONAL - rate limiting (Phase 5E.9). All are optional with sane defaults.
# -------------------------------------------------------------------------
# Master switch for BOTH the global client-IP limiter and the per-user
# authenticated/expensive limiter. Set false only for load-testing (or targeted
# tests that bypass counting).
# RATE_LIMIT_ENABLED=true

# Storage backend key namespace. Only "memory" is currently shipped (single
# process only). Production multi-instance deployments MUST use a shared
# backend (Redis etc.); running production with "memory" logs a startup warning
# because the limiter is single-instance in that mode.
# RATE_LIMIT_BACKEND=memory

# Fixed-window length, in seconds, for all limit buckets.
# RATE_LIMIT_WINDOW_SECONDS=60

# Per-user (verified Firebase UID) ceiling across protected endpoints.
# RATE_LIMIT_AUTHENTICATED_MAX=300

# Per client IP ceiling across all non-health endpoints (applies to
# unauthenticated / invalid-token requests too).
# RATE_LIMIT_ANONYMOUS_MAX=120

# Stricter per-user ceiling for AI discovery/matching/tailoring, resume
# parsing, and document uploads (the expensive/sensitive operations).
# RATE_LIMIT_EXPENSIVE_MAX=30

# Cap on concurrent counter buckets held in memory by the memory backend.
# # RATE_LIMIT_MAX_KEYS=20000

# Opt-in flag for trusting X-Forwarded-For/X-Real-IP as the client identity.
# Currently reserved (no proxy-header parsing is performed) and default false,
# so spoofed proxy headers are never trusted.
# RATE_LIMIT_TRUST_PROXY=false


# -------------------------------------------------------------------------
# OPTIONAL - backup & recovery (Phase 5E.11). Operational tooling only;
# the FastAPI application itself never backs up or restores databases.
# Tools: `python -m app.ops.backup create|list|verify|cleanup|restore`.
# -------------------------------------------------------------------------
# Directory that stores pg_dump archives (.dump) plus a SHA-256 sidecar
# (.dump.sha256) per archive. When empty, the project-local default
# backend/backups is used. Production MUST point this at a dedicated volume
# on the database host (or a mounted backup volume) that is itself backed up
# off-host. Backups are NEVER stored inside PostgreSQL and are NOT part of a
# database backup - they are the database backup.
# BACKUP_DIR=/var/backups/careerpilot

# Number of newest valid backups to retain. Older archives are removed by
# `python -m app.ops.backup cleanup` (deterministic, newest always kept).
# Must be >= 1. Count-based retention is deliberate for the beta; cloud
# lifecycle retention can later be configured at the infrastructure layer.
# BACKUP_RETENTION_COUNT=30

# Firebase backend verification. One of two mechanisms is used:
#   1) A Firebase service-account JSON file placed at
#      backend/firebase-service-account.json (gitignored) - takes priority, or
#   2) Firebase Application Default Credentials, activated when
#      FIREBASE_PROJECT_ID is configured (plus GOOGLE_APPLICATION_CREDENTIALS
#      set by the hosting platform).
# If NEITHER mechanism is available, every protected request fails closed with
# HTTP 401 - the app will not expose data with auth disabled.
FIREBASE_PROJECT_ID=your-firebase-project-id

# -------------------------------------------------------------------------
# OPTIONAL - external job sources (features degrade if unset)
# -------------------------------------------------------------------------

ADZUNA_APP_ID=your-adzuna-app-id
ADZUNA_APP_KEY=your-adzuna-app-key
ADZUNA_COUNTRY=us

# External job source request timeouts (seconds). Discovery never waits forever.
ADZUNA_TIMEOUT_SECONDS=20
JOBICY_TIMEOUT_SECONDS=20

# Jooble API integration (Phase 5A). Free tier: 500 lifetime requests per key.
# Obtain a key at https://jooble.org/api/about
JOOBLE_API_KEY=
JOOBLE_TIMEOUT_SECONDS=20

# -------------------------------------------------------------------------
# OPTIONAL - AI resume tailoring / cover letters (Phase 3A)
# Leave empty to disable; the API returns a clear error.
# -------------------------------------------------------------------------
AI_PROVIDER=openai
AI_API_KEY=
AI_MODEL=gpt-4o-mini
# Optional custom OpenAI-compatible endpoint (e.g. OpenRouter).
AI_BASE_URL=
AI_TIMEOUT_SECONDS=60